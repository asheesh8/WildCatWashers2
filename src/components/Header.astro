---
import { company, nav, cta } from '@/data/business';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

/* Split navigation around a centred logo, in the manner of Pink's. */
const left = nav.primary.slice(0, 3);
const right = nav.primary.slice(3);
---

<header class="hdr" id="site-header">
  <div class="wrap hdr-in">
    <nav class="hdr-nav hdr-left" aria-label="Primary">
      <ul>
        {left.map((item) => (
          <li class={item.children ? 'has-sub' : ''}>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
              {item.children && (
                <svg viewBox="0 0 24 24" aria-hidden="true" class="chev"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              )}
            </a>
            {item.children && (
              <div class="sub">
                <ul>{item.children.map((c) => (<li><a href={c.href}>{c.label}</a></li>))}</ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <a href="/" class="hdr-logo" aria-label={`${company.name} — home`}>
      <img src="/brand/logo-long.svg" alt={`${company.name}`} width="220" height="90" />
    </a>

    <nav class="hdr-nav hdr-right" aria-label="Secondary">
      <ul>
        {right.map((item) => (
          <li class={item.children ? 'has-sub' : ''}>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
              {item.children && (
                <svg viewBox="0 0 24 24" aria-hidden="true" class="chev"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              )}
            </a>
            {item.children && (
              <div class="sub">
                <ul>{item.children.map((c) => (<li><a href={c.href}>{c.label}</a></li>))}</ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr-cta">
      <a class="hdr-phone" href={`tel:${company.phoneRaw}`} data-track="call-header">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>{company.phone}</span>
      </a>
      <a class="btn btn-sm" href="/quote/" data-track="quote-header">{cta.primaryShort}</a>
    </div>

    <button class="hdr-burger" id="burger" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mnav" id="mobile-nav" hidden>
    <div class="mnav-in">
      <nav aria-label="Mobile">
        <ul class="mnav-list">
          {nav.primary.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
              {item.children && (
                <ul class="mnav-sub">{item.children.map((c) => (<li><a href={c.href}>{c.label}</a></li>))}</ul>
              )}
            </li>
          ))}
          <li><a href="/guarantee/">Our Guarantees</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
      <div class="mnav-cta">
        <a class="btn btn-block" href="/quote/">{cta.primary}</a>
        <a class="btn btn-ghost btn-block" href={`tel:${company.phoneRaw}`}>{cta.secondary}</a>
      </div>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 100;
    background: rgba(255, 255, 255, .94);
    backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .hdr-in {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto;
    align-items: center;
    gap: 1.25rem;
    min-height: 84px;
  }

  /* --- split nav --- */
  .hdr-nav > ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: .1rem; }
  .hdr-right > ul { justify-content: flex-end; }
  .hdr-nav > ul > li { position: relative; }
  .hdr-nav > ul > li > a {
    display: flex; align-items: center; gap: .3rem;
    padding: .6rem .7rem; border-radius: 9px;
    font-family: var(--font-display); font-weight: 700;
    font-size: .78rem; letter-spacing: .09em; text-transform: uppercase;
    color: var(--navy); text-decoration: none;
    white-space: nowrap;
    transition: color .15s var(--ease);
  }
  .hdr-nav > ul > li > a:hover,
  .hdr-nav > ul > li > a[aria-current='page'] { color: var(--red); }
  .chev { width: 12px; height: 12px; opacity: .5; transition: transform .2s var(--ease); }
  .has-sub:hover .chev, .has-sub:focus-within .chev { transform: rotate(180deg); }

  .sub {
    position: absolute; top: calc(100% + 6px); left: 0;
    min-width: 244px;
    background: #fff; border: 1px solid var(--line);
    border-radius: var(--radius); box-shadow: var(--shadow-lg);
    padding: .45rem;
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity .18s var(--ease), transform .18s var(--ease), visibility .18s;
  }
  .hdr-right .sub { left: auto; right: 0; }
  .has-sub:hover .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; transform: none; }
  .sub ul { list-style: none; margin: 0; padding: 0; }
  .sub a {
    display: block; padding: .6rem .8rem; border-radius: 9px;
    color: var(--ink-2); text-decoration: none; font-weight: 600; font-size: .94rem;
  }
  .sub a:hover { background: var(--cyan-50); color: var(--navy); }

  /* --- centred logo --- */
  .hdr-logo { display: block; line-height: 0; justify-self: center; }
  .hdr-logo img { width: clamp(140px, 14vw, 186px); height: auto; }

  /* --- right-hand actions --- */
  .hdr-cta { display: flex; align-items: center; gap: .85rem; }
  .hdr-phone {
    display: inline-flex; align-items: center; gap: .45rem;
    text-decoration: none; color: var(--navy);
    font-family: var(--font-display); font-weight: 800; font-size: .97rem; letter-spacing: -.02em;
    white-space: nowrap;
  }
  .hdr-phone svg { width: 17px; height: 17px; color: var(--cyan-600); flex: none; }
  .hdr-phone:hover { color: var(--red); }

  /* --- burger --- */
  .hdr-burger {
    display: none;
    width: 46px; height: 46px; border: 1px solid var(--line); border-radius: 12px;
    background: #fff; padding: 0;
    flex-direction: column; align-items: center; justify-content: center; gap: 5px;
  }
  .hdr-burger span { display: block; width: 20px; height: 2.5px; border-radius: 2px; background: var(--navy); transition: transform .25s var(--ease), opacity .2s; }
  .hdr-burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }
  .hdr-burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .hdr-burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7.5px) rotate(-45deg); }

  @media (max-width: 1180px) {
    .hdr-nav { display: none; }
    .hdr-burger { display: flex; }
    .hdr-in { grid-template-columns: auto 1fr auto; min-height: 72px; }
    .hdr-logo { justify-self: start; }
    .hdr-cta { justify-self: end; }
  }
  @media (max-width: 560px) {
    .hdr-cta .btn { display: none; }
    .hdr-in { min-height: 66px; gap: .75rem; }
  }

  /* --- mobile drawer --- */
  .mnav { border-top: 1px solid var(--line); background: #fff; max-height: calc(100dvh - 110px); overflow-y: auto; animation: drop .22s var(--ease); }
  @keyframes drop { from { opacity: 0; transform: translateY(-10px); } }
  .mnav-in { padding: 1rem var(--gutter) 1.6rem; }
  .mnav-list { list-style: none; margin: 0 0 1.2rem; padding: 0; }
  .mnav-list > li > a {
    display: block; padding: .85rem 0;
    font-family: var(--font-display); font-weight: 800; font-size: 1.14rem;
    text-transform: uppercase; letter-spacing: -.01em;
    color: var(--navy); text-decoration: none;
    border-bottom: 1px solid var(--line-2);
  }
  .mnav-sub { list-style: none; margin: .2rem 0 .6rem; padding: 0 0 0 .9rem; border-left: 2px solid var(--cyan-100); }
  .mnav-sub a { display: block; padding: .5rem 0; color: var(--ink-2); text-decoration: none; font-weight: 600; font-size: 1rem; }
  .mnav-cta { display: grid; gap: .7rem; }
</style>

<script is:inline>
  (() => {
    const burger = document.getElementById('burger');
    const menu = document.getElementById('mobile-nav');
    if (!burger || !menu) return;
    const close = () => {
      burger.setAttribute('aria-expanded', 'false');
      burger.setAttribute('aria-label', 'Open menu');
      menu.hidden = true;
    };
    burger.addEventListener('click', () => {
      const open = burger.getAttribute('aria-expanded') === 'true';
      if (open) return close();
      burger.setAttribute('aria-expanded', 'true');
      burger.setAttribute('aria-label', 'Close menu');
      menu.hidden = false;
    });
    menu.addEventListener('click', (e) => { if (e.target.closest('a')) close(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) { close(); burger.focus(); }
    });
  })();
</script>
