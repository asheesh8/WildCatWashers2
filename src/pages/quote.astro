---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import QuoteForm from '@/components/QuoteForm.astro';
import { company, proof, guarantees, process, awards, offers } from '@/data/business';
import { img, altFor } from '@/data/media';
---
<Base
  title="Get a Free Quote | Wildcat Washers Tucson"
  description={`Free, no-obligation quote for window cleaning, solar panel cleaning or pressure washing across Greater Tucson. Fixed price, usually the same day — and you don't pay until you're happy.`}
  canonical="/quote/"
  breadcrumbs={[{ name: 'Get a Quote', href: '/quote/' }]}
>
  <section class="q">
    <div class="wrap q-in">
      <div class="q-form-col">
        <p class="eyebrow">Free quote</p>
        <h1>Tell us what needs cleaning.</h1>
        <p class="lede">
          Four quick questions. You get a fixed price — usually the same day — with no site
          visit needed for most homes and no obligation to book.
        </p>
        <div class="q-card">
          <QuoteForm id="main-quote" />
        </div>
      </div>

      <aside class="q-side">
        <div class="q-box">
          <h2>Rather just talk?</h2>
          <a class="tel-link q-tel" href={`tel:${company.phoneRaw}`} data-track="call-quote">{company.phone}</a>
          <p>Call or text. {company.hoursHuman}.</p>
          <a class="q-mail" href={`mailto:${company.email}`}>{company.email}</a>
        </div>

        <div class="q-box">
          <h2>What happens next</h2>
          <ol class="q-steps">
            {process.slice(0, 4).map((p) => (
              <li><strong>{p.name}</strong><span>{p.body}</span></li>
            ))}
          </ol>
        </div>

        <div class="q-box q-box-cyan">
          <h2>Current offers</h2>
          <ul class="q-offers">
            {offers.filter((o) => o.active).map((o) => (
              <li><strong>{o.headline}</strong><span>{o.detail}</span></li>
            ))}
          </ul>
        </div>

        <div class="q-box">
          <h2>Zero risk</h2>
          {guarantees.map((g) => (
            <div class="q-guar"><strong>{g.name}</strong><p>{g.headline}</p></div>
          ))}
        </div>

        <figure class="q-fig">
          <Image src={img('team-truck-lineup-tucson')} alt={altFor('team-truck-lineup-tucson')} widths={[380, 700]} sizes="(max-width: 980px) 92vw, 32vw" quality={74} class="cover" />
          <figcaption>{proof.customersServedLabel} homes and businesses across {company.region}. Never a review below five stars.</figcaption>
        </figure>

        <ul class="q-awards">
          {awards.map((a) => <li>{a.short}{a.year ? ` ${a.year}` : ''}</li>)}
        </ul>
      </aside>
    </div>
  </section>
</Base>

<style>
  .q { padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 6vw, 5rem); }
  .q-in { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (max-width: 980px) { .q-in { grid-template-columns: 1fr; } }
  .q h1 { font-size: var(--step-4); margin-block: .55rem .8rem; text-transform: none; }
  .q .lede { max-width: 56ch; margin-bottom: 2rem; }
  .q-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius-xl); padding: clamp(1.5rem, 3vw, 2.25rem); box-shadow: var(--shadow); }

  .q-side { display: grid; gap: 1.1rem; position: sticky; top: 110px; }
  @media (max-width: 980px) { .q-side { position: static; } }
  .q-box { background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 1.4rem 1.5rem; }
  .q-box-cyan { background: var(--cyan-50); border-color: var(--cyan-100); }
  .q-box h2 { font-size: 1.02rem; letter-spacing: .04em; margin-bottom: .75rem; }
  .q-tel { font-size: 1.65rem; display: block; margin-bottom: .3rem; }
  .q-box p { font-size: .92rem; color: var(--ink-3); }
  .q-mail { display: inline-block; margin-top: .5rem; font-size: .93rem; word-break: break-all; }

  .q-steps { margin: 0; padding-left: 1.15rem; display: grid; gap: .7rem; }
  .q-steps li::marker { font-family: var(--font-display); font-weight: 900; color: var(--cyan-600); }
  .q-steps strong { display: block; font-family: var(--font-display); font-size: .97rem; color: var(--navy); }
  .q-steps span { font-size: .89rem; color: var(--ink-2); line-height: 1.5; }

  .q-offers { list-style: none; margin: 0; padding: 0; display: grid; gap: .8rem; }
  .q-offers strong { display: block; font-family: var(--font-display); font-size: 1rem; color: var(--navy); }
  .q-offers span { font-size: .89rem; color: var(--ink-2); line-height: 1.5; }

  .q-guar { padding-top: .8rem; }
  .q-guar:first-of-type { padding-top: 0; }
  .q-guar strong { display: block; font-family: var(--font-display); font-size: .98rem; color: var(--navy); }
  .q-guar p { font-size: .89rem !important; color: var(--ink-2) !important; line-height: 1.5; }

  .q-fig { margin: 0; }
  .q-fig :global(img) { width: 100%; border-radius: var(--radius-lg); aspect-ratio: 16/10; object-fit: cover; }
  .q-fig figcaption { margin-top: .7rem; font-size: .88rem; color: var(--ink-3); line-height: 1.5; }

  .q-awards { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem; }
  .q-awards li { padding: .35rem .75rem; border-radius: 999px; background: #fff; border: 1px solid var(--line); font-size: .8rem; font-weight: 600; color: var(--ink-2); }
</style>
